{
  "name": "Portfolio Insights Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  
  // Funzionalità aggiuntive (Features) utili per lo sviluppo
  "features": {
    // Permette di usare Git all'interno del container con le credenziali del tuo Mac ospite
    "ghcr.io/devcontainers/features/git:1": {}
  },

  // Configura le impostazioni di VS Code all'interno del container
  "customizations": {
    "vscode": {
      "settings": {
        "files.autoSave": "onFocusChange",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      },
      // Estensioni installate automaticamente nel container all'avvio
      "extensions": [
        "dbaeumer.vscode-eslint",      // Linter
        "esbenp.prettier-vscode",      // Formattatore di codice
        "Prisma.prisma",               // Supporto per database Prisma
        "coenraets.bracket-pair-colorizer-2"
      ]
    }
  },

  // Esegue l'installazione delle dipendenze e la preparazione del database dopo la creazione del container
  "postCreateCommand": "pnpm install && pnpm db:generate && pnpm db:push",

  // Evita di far girare il container come root, usa l'utente 'node' creato nel Dockerfile
  "remoteUser": "node"
}
