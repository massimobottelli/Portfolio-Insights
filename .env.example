# Portfolio Insights — configurazione Docker Compose
# Copia questo file in .env e adatta i valori:
#   cp .env.example .env
#
# Il file .env è già escluso da git e dal build context Docker.
# In LOCALE (senza Docker) il file .env viene caricato automaticamente da
# npm start / npm run dev / npm run prices:update (flag Node --env-file-if-exists).

# Porta pubblica su cui esporre l'applicazione
APP_PORT=3000

# Token API di accesso (usato dalla schermata di login).
# Se lasciato vuoto (o se il file .env non esiste), l'app genera un token
# casuale al primo avvio e lo salva sia in .env (riga API_TOKEN= valorizzata
# automaticamente) sia in /app/db/.api-token (permessi 600).
# In Docker lo vedi nel log: docker compose logs portfolio-insights
API_TOKEN=

# --- Prezzi di chiusura giornalieri (EODHD) --------------------------------
# API key per i dati storici e incrementali di EODHD.
# Usata SOLO lato server/CLI (scripts/update-daily-closing-prices.js):
# mai esposta al frontend, mai loggata, mai inclusa negli URL stampati.
# Senza questa variabile lo script di aggiornamento incrementale termina
# con un messaggio esplicativo.
EODHD_API_KEY=
