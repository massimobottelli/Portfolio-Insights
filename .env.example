# Portfolio Insights — configurazione Docker Compose
# Copia questo file in .env e adatta i valori:
#   cp .env.example .env
#
# Il file .env è già escluso da git e dal build context Docker.

# Porta pubblica su cui esporre l'applicazione
APP_PORT=3000

# Token API di accesso (usato dalla schermata di login).
# Se lasciato vuoto (o se il file .env non esiste), l'app genera un token
# casuale al primo avvio e lo salva in /app/db/.api-token.
# Recuperarlo con: docker compose logs portfolio-insights
API_TOKEN=
